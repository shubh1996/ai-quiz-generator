# Perplexity API Configuration (REQUIRED)
# Used for: Quiz generation + Educational content verification
# Get your API key from https://www.perplexity.ai/
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# YouTube Data API v3 Configuration (RECOMMENDED for YouTube videos)
# Helps verify video metadata and caption availability
# Get your API key from https://console.cloud.google.com
YOUTUBE_API_KEY=your_youtube_api_key_here

# RapidAPI YouTube Transcripts (RECOMMENDED for production/cloud servers)
# Most reliable method for fetching YouTube transcripts - bypasses bot detection
# Free tier: 100 requests/month | ULTRA: $29/month for 10,000 requests
# Get your API key from https://rapidapi.com/8v2FWW4H6AmKw89/api/youtube-transcripts
RAPIDAPI_KEY=your_rapidapi_key_here

# Optional: Video processing configuration
MAX_VIDEO_SIZE_MB=500
MAX_VIDEO_DURATION_SECONDS=7200

# Optional: Frontend URL for CORS (production)
FRONTEND_URL=https://your-frontend-domain.com
